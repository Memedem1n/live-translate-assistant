{
  "name": "live-translate-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local real-time meeting translation and bilingual response assistant",
  "main": "./out/main/index.js",
  "author": "Memedem1n",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "asset:icon": "powershell -ExecutionPolicy Bypass -File scripts/generate_icon.ps1 -OutputPath build/icon.ico",
    "codesign:check": "powershell -ExecutionPolicy Bypass -File scripts/check_codesign_readiness.ps1",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run asset:icon && npm run build && electron-builder --win --x64 --publish never",
    "build:win:dir": "npm run asset:icon && npm run build && electron-builder --win --x64 --dir --publish never",
    "benchmark": "python scripts/benchmark_runner.py --clips-manifest benchmark/clips/manifest.json --runs 3",
    "lint": "echo \"lint rules will be added in M2\"",
    "format": "echo \"format command will be added in M2\""
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
