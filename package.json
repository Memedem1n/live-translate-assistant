{
  "name": "live-translate-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local real-time meeting translation and bilingual response assistant",
  "main": "./out/main/index.js",
  "author": "Memedem1n",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "asset:icon": "powershell -ExecutionPolicy Bypass -File scripts/generate_icon.ps1 -OutputPath build/icon.ico",
    "codesign:check": "powershell -ExecutionPolicy Bypass -File scripts/check_codesign_readiness.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run asset:icon && npm run build && electron-builder --win --x64 --publish never",
    "build:win:dir": "npm run asset:icon && npm run build && electron-builder --win --x64 --dir --publish never",
    "benchmark": "powershell -ExecutionPolicy Bypass -File scripts/run_venv_python.ps1 scripts/benchmark_runner.py --clips-manifest benchmark/clips/manifest.json --runs 3",
    "runtime:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup_runtime.ps1",
    "models:pull": "powershell -ExecutionPolicy Bypass -File scripts/pull_models.ps1 -Profile full",
    "clips:prepare": "powershell -ExecutionPolicy Bypass -File scripts/run_venv_python.ps1 scripts/prepare_sample_clips.py --out-dir artifacts/bench_clips",
    "stt:prewarm": "powershell -ExecutionPolicy Bypass -File scripts/run_venv_python.ps1 scripts/prewarm_stt_models.py --models small.en medium.en large-v3 --device auto",
    "benchmark:sweep": "powershell -ExecutionPolicy Bypass -File scripts/run_venv_python.ps1 scripts/model_sweep.py --manifest artifacts/bench_clips/manifest.json --runs 3 --stt-device auto --target-stt-ms 800 --target-first-token-ms 900 --target-assist-final-ms 2500",
    "demo:pipeline": "powershell -ExecutionPolicy Bypass -File scripts/run_demo_pipeline.ps1 -Runs 3",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.cjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^3.2.4"
  }
}
