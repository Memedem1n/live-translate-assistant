    "malformed_output_rate_gt": 0.02,
    "critical_hallucination_rate_gte": 0.03,
    "persona_contradiction_rate_gte": 0.05
  },
  "llama_vs_qwen_rule": {
    "promote_llama_if_quality_gap_gte": 0.3,
    "promote_llama_if_latency_penalty_lte_ratio": 0.15,
    "otherwise": "promote_qwen"
  }
}
